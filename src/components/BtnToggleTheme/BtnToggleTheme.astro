---
import toggleDarkSvg from '../../assets/toggle-dark.svg?raw';
import toggleLightSvg from '../../assets/toggle-light.svg?raw';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button class={className} aria-label="theme toggle" data-theme-toggle>
  <span data-icon="dark" set:html={toggleDarkSvg} />
  <span data-icon="light" set:html={toggleLightSvg} />
</button>

<style>
  button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 0.375rem 0.75rem;
    border-radius: 0.25rem;
    cursor: pointer;
  }
  [data-icon] {
    display: none;
  }
  [data-icon] :global(svg) {
    width: 27px;
    height: auto;
    color: var(--toggle-theme);
  }
  :global(html.dark) [data-icon='dark'] {
    display: inline-flex;
  }
  :global(html.light) [data-icon='light'] {
    display: inline-flex;
  }
</style>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const nowDark = !root.classList.contains('dark');
      root.classList.toggle('dark', nowDark);
      root.classList.toggle('light', !nowDark);
      try {
        localStorage.setItem('dark', JSON.stringify(nowDark));
      } catch {
        // ignore storage failures (private mode, disabled storage)
      }
    });
  });
</script>
