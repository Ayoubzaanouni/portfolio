# Copy to .env.local and fill in from Supabase: Project Settings -> API
# PUBLIC_ vars are readable both server-side (Astro pages/API routes) and
# client-side (islands) — that's fine here, they're the public anon key.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Contact form, client side: reCAPTCHA v2 site key (public, safe to expose).
# From https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Contact form, server side only (src/pages/api/contact.js) — never prefix
# these with PUBLIC_, they must not be shipped to the browser.
# reCAPTCHA secret key, from the same reCAPTCHA admin page as the site key.
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# EmailJS (emailjs.com) service/template id, and a Private Key from
# EmailJS dashboard -> Account -> API Keys (used to send server-to-server,
# bypassing the origin check that's meant for browser-only public keys).
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
